<Window x:Class="ShuBingDesktopPet.ObsCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="薯餅 OBS 擷取"
        Width="300"
        Height="300"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Background="Transparent"
        Focusable="False"
        SnapsToDevicePixels="True">
    <Canvas x:Name="CaptureCanvas" Background="Transparent">
        <Viewbox x:Name="PetViewbox" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Uniform" StretchDirection="Both">
            <Grid x:Name="PetRenderRoot" Width="192" Height="208" Background="Transparent">
                <Image x:Name="FrameImage" Width="192" Height="208" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,1">
                    <Image.RenderTransform>
                        <TransformGroup x:Name="FrameImageTransformGroup">
                            <ScaleTransform x:Name="FrameImageScaleTransform" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="FrameImageTranslateTransform" X="0" Y="0" />
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <Canvas x:Name="FallbackCanvas" Width="192" Height="208" HorizontalAlignment="Center" IsHitTestVisible="False">
                    <Ellipse x:Name="FallbackBody" Width="110" Height="90" Fill="#FFE3C3A1" Stroke="#B36A3A" StrokeThickness="2"
                             Canvas.Left="41" Canvas.Top="95" />
                    <Ellipse x:Name="FallbackHead" Width="80" Height="70" Fill="#F7D8B0" Stroke="#B36A3A" StrokeThickness="2"
                             Canvas.Left="56" Canvas.Top="30" />
                    <Ellipse Width="12" Height="12" Fill="#3A2A18" Canvas.Left="80" Canvas.Top="52" />
                    <Ellipse Width="12" Height="12" Fill="#3A2A18" Canvas.Left="100" Canvas.Top="52" />
                    <Ellipse Width="8" Height="6" Fill="#111111" Canvas.Left="104" Canvas.Top="66" />
                    <Ellipse Width="8" Height="6" Fill="#111111" Canvas.Left="84" Canvas.Top="66" />
                    <Line X1="60" Y1="58" X2="74" Y2="64" Stroke="#A06E44" StrokeThickness="2" />
                    <Line X1="132" Y1="58" X2="118" Y2="64" Stroke="#A06E44" StrokeThickness="2" />
                    <Ellipse Width="30" Height="12" Fill="#FF9AAE8A" Canvas.Left="81" Canvas.Top="82" />
                </Canvas>
            </Grid>
        </Viewbox>
    </Canvas>
</Window>
