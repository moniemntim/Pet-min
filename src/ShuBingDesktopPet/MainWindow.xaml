<Window x:Class="ShuBingDesktopPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/ShuBingDesktopPet.ico"
        Width="192"
        Height="208"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SnapsToDevicePixels="True"
        Focusable="False">
    <Viewbox x:Name="PetViewbox" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Stretch="Uniform" StretchDirection="Both">
        <Grid x:Name="PetRenderRoot" Width="192" Height="208" Background="Transparent">
            <Image x:Name="FrameImage" Width="192" Height="208" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.5,1">
                <Image.RenderTransform>
                    <TransformGroup x:Name="FrameImageTransformGroup">
                        <ScaleTransform x:Name="FrameImageScaleTransform" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="FrameImageTranslateTransform" X="0" Y="0" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
            <Canvas x:Name="FallbackCanvas" Width="192" Height="208" IsHitTestVisible="False">
                <Ellipse x:Name="FallbackBody" Width="110" Height="90" Fill="#FFE3C3A1" Stroke="#B36A3A" StrokeThickness="2"
                         Canvas.Left="41" Canvas.Top="95" />
                <Ellipse x:Name="FallbackHead" Width="80" Height="70" Fill="#F7D8B0" Stroke="#B36A3A" StrokeThickness="2"
                         Canvas.Left="56" Canvas.Top="30" />
                <Ellipse Width="12" Height="12" Fill="#3A2A18" Canvas.Left="80" Canvas.Top="52" />
                <Ellipse Width="12" Height="12" Fill="#3A2A18" Canvas.Left="100" Canvas.Top="52" />
                <Ellipse Width="8" Height="6" Fill="#111111" Canvas.Left="104" Canvas.Top="66" />
                <Ellipse Width="8" Height="6" Fill="#111111" Canvas.Left="84" Canvas.Top="66" />
                <Line X1="60" Y1="58" X2="74" Y2="64" Stroke="#A06E44" StrokeThickness="2" />
                <Line X1="132" Y1="58" X2="118" Y2="64" Stroke="#A06E44" StrokeThickness="2" />
                <Ellipse Width="30" Height="12" Fill="#FF9AAE8A" Canvas.Left="81" Canvas.Top="82" />
            </Canvas>
            <Canvas x:Name="FeedOverlay" Width="192" Height="208" IsHitTestVisible="False" Visibility="Collapsed">
                <Canvas x:Name="FeedApple" Width="30" Height="32" Canvas.Left="81" Visibility="Collapsed">
                    <Ellipse Width="22" Height="22" Fill="#D93636" Stroke="#8D1E1E" StrokeThickness="1" Canvas.Left="4" Canvas.Top="8" />
                    <Rectangle Width="3" Height="8" Fill="#5D3A1A" RadiusX="1" RadiusY="1" Canvas.Left="14" Canvas.Top="2" />
                    <Ellipse Width="10" Height="6" Fill="#63A844" RenderTransformOrigin="0,0.5" Canvas.Left="16" Canvas.Top="3">
                        <Ellipse.RenderTransform><RotateTransform Angle="-24" /></Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
                <Canvas x:Name="FeedCarrot" Width="32" Height="42" Canvas.Left="80" Visibility="Collapsed">
                    <Path x:Name="FeedCarrotBody" Fill="#F58232" Stroke="#B84C13" StrokeThickness="1" Data="M7,12 C11,7 24,7 27,12 C25,23 18,33 11,40 C10,29 7,21 7,12 Z" />
                    <Path x:Name="FeedCarrotTop" Fill="#69A83A" Data="M15,11 L10,2 L16,7 L17,0 L20,8 L27,3 L23,12 Z" />
                </Canvas>
                <Canvas x:Name="FeedPellet" Width="34" Height="30" Canvas.Left="79" Visibility="Collapsed">
                    <Ellipse Width="8" Height="8" Fill="#8A6544" Canvas.Left="6" Canvas.Top="3" />
                    <Ellipse Width="8" Height="8" Fill="#9A724B" Canvas.Left="14" Canvas.Top="1" />
                    <Ellipse Width="8" Height="8" Fill="#765338" Canvas.Left="22" Canvas.Top="4" />
                    <Path Fill="#B88455" Stroke="#6F482A" StrokeThickness="1" Data="M2,9 L32,9 L27,27 L7,27 Z" />
                    <Ellipse Width="30" Height="9" Fill="#D2A06D" Stroke="#6F482A" StrokeThickness="1" Canvas.Left="2" Canvas.Top="6" />
                    <Ellipse Width="6" Height="6" Fill="#765338" Canvas.Left="8" Canvas.Top="8" />
                    <Ellipse Width="6" Height="6" Fill="#8A6544" Canvas.Left="15" Canvas.Top="7" />
                    <Ellipse Width="6" Height="6" Fill="#765338" Canvas.Left="22" Canvas.Top="9" />
                </Canvas>
                <TextBlock x:Name="FeedStatusText" Foreground="White" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                           TextAlignment="Center" Width="192" Canvas.Top="24" TextWrapping="Wrap" Opacity="0.95">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Opacity="0.85" />
                    </TextBlock.Effect>
                </TextBlock>
            </Canvas>
        </Grid>
    </Viewbox>
</Window>
