<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ShuBingDesktopPet</RootNamespace>
    <AssemblyName>ShuBingDesktopPet</AssemblyName>
    <Version>1.1.0-rc.9</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <ApplicationIcon>Assets\ShuBingDesktopPet.ico</ApplicationIcon>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <None Remove="Assets\Feeding\Apple\**\*" />
    <None Remove="Assets\Feeding\Carrot\**\*" />
    <None Remove="Assets\Feeding\Pellet\**\*" />
    <Resource Include="Assets\Feeding\Apple\**\*" />
    <Resource Include="Assets\Feeding\Carrot\**\*" />
    <Resource Include="Assets\Feeding\Pellet\**\*" />
    <None Remove="Assets\Walking\LongBody\**\*" />
    <Resource Include="Assets\Walking\LongBody\**\*" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\ShuBingDesktopPet.ico" />
    <Resource Include="Assets\ShuBingDesktopPet.ico" />
  </ItemGroup>

  <PropertyGroup>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>
</Project>
