<Window x:Class="ShuBingDesktopPet.PetSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/ShuBingDesktopPet.ico"
        Title="薯餅桌寵設定"
        WindowStartupLocation="CenterScreen"
        Width="360"
        Height="620"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow">
    <ScrollViewer>
    <StackPanel Margin="12">
        <TextBlock Text="桌寵設定" FontSize="18" FontWeight="SemiBold" />
        <CheckBox x:Name="RoamingEnabledBox" Content="啟用漫遊" Margin="0,0,0,8" />
        <TextBlock Text="漫遊範圍" Margin="0,0,0,4" />
        <ComboBox x:Name="RoamingScopeBox" Margin="0,0,0,8" />
        <TextBlock Text="速度" Margin="0,0,0,4" />
        <ComboBox x:Name="SpeedBox" Margin="0,0,0,8" />
        <TextBlock Text="大小（75%–150%）" Margin="0,0,0,4" />
        <Slider x:Name="ScaleSlider" Minimum="0.75" Maximum="1.5" SmallChange="0.05" LargeChange="0.05" TickFrequency="0.05" IsSnapToTickEnabled="True" />
        <TextBlock Text="寵物身形" Margin="0,10,0,4" />
        <ComboBox x:Name="WalkingBodyStyleBox" Margin="0,0,0,8" />
        <TextBlock Text="每次吃食物時間" Margin="0,0,0,4" />
        <TextBlock x:Name="FeedingDurationLabel" Margin="0,0,0,2" />
        <Slider x:Name="FeedingDurationSlider" Minimum="1" Maximum="20" SmallChange="0.5" LargeChange="1" TickFrequency="0.5" IsSnapToTickEnabled="True" />
        <TextBlock Text="連續走路時間" Margin="0,10,0,4" />
        <TextBlock x:Name="ContinuousWalkDurationLabel" Margin="0,0,0,2" />
        <Slider x:Name="ContinuousWalkDurationSlider" Minimum="2" Maximum="60" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" />
        <CheckBox x:Name="ClickThroughBox" Content="滑鼠穿透" Margin="0,8,0,8" />
        <CheckBox x:Name="ObsCaptureEnabledBox" Content="啟用 OBS 擷取視窗" Margin="0,0,0,8" />
        <TextBlock Text="OBS 擷取解析度" Margin="0,0,0,4" />
        <ComboBox x:Name="ObsCaptureResolutionBox" Margin="0,0,0,8" />
        <CheckBox x:Name="StartWithWindowsBox" Content="開機啟動" Margin="0,0,0,8" />
        <Separator Margin="0,4,0,8" />
        <TextBlock Text="Twitch Bits 餵食" FontSize="15" FontWeight="SemiBold" />
        <CheckBox x:Name="TwitchEnabledBox" Content="啟用 Twitch" Margin="0,4,0,4" />
        <TextBlock Text="Client ID（Public app）" />
        <TextBox x:Name="TwitchClientIdBox" Margin="0,2,0,6" MaxLength="128" />
        <TextBlock Text="最低 Bits" />
        <TextBox x:Name="TwitchMinimumBitsBox" Margin="0,2,0,8" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="SaveButton" Content="儲存" Width="90" Margin="0,0,8,0" />
                <Button x:Name="CancelButton" Content="取消" Width="90" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
